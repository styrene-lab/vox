# Omegon + Vox discord agent container.
#
# Pre-build the binaries, then stage them:
#   cargo zigbuild --release --target aarch64-unknown-linux-gnu -p vox --features all
#   cd ../omegon/core && cargo zigbuild --release --target aarch64-unknown-linux-gnu -p omegon
#   cp target/aarch64-unknown-linux-gnu/release/vox deploy/bin/vox
#   cp ../omegon/core/target/aarch64-unknown-linux-gnu/release/omegon deploy/bin/omegon
#
# Build:
#   podman build -f deploy/Containerfile.discord-agent -t discord-agent .
#
# Run:
#   podman run --rm -it \
#     -e ANTHROPIC_API_KEY=sk-... \
#     -e VOX_DISCORD_BOT_TOKEN=... \
#     discord-agent

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Omegon daemon binary
COPY deploy/bin/omegon /usr/local/bin/omegon
RUN chmod +x /usr/local/bin/omegon

# Vox extension binary
RUN mkdir -p /data/omegon/extensions/vox/bin
COPY deploy/bin/vox /data/omegon/extensions/vox/bin/vox
RUN chmod +x /data/omegon/extensions/vox/bin/vox

# Vox extension manifest (binary path relative to extension dir)
COPY deploy/manifest.container.toml /data/omegon/extensions/vox/manifest.toml

# Vox runtime config (discord-only for this image)
COPY deploy/discord-agent.toml /etc/vox/vox.toml

# Entrypoint script
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Isolated omegon state
ENV OMEGON_HOME=/data/omegon
ENV VOX_CONFIG=/etc/vox/vox.toml
ENV RUST_LOG=info

# Daemon control port
EXPOSE 7842

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
