# Styrene Community Agent — Discord deployment
# Fill in values and run:
#   podman run -d --name styrene-community -p 7843:7842 \
#     --env-file deploy/.env.styrene-community \
#     auspex-agents --agent styrene.community-agent

# LLM provider
ANTHROPIC_API_KEY=

# Discord bot token (from Discord Developer Portal)
VOX_DISCORD_BOT_TOKEN=

# Operator Discord user IDs (comma-separated, full instruction authority)
VOX_DISCORD_OPERATORS=

# Operator role IDs (comma-separated, grants operator trust to role members)
# VOX_DISCORD_OPERATOR_ROLES=

# Restrict to a single Discord server (optional)
# VOX_DISCORD_GUILD_ID=

# Require @mention in channels (DMs always pass)
VOX_DISCORD_REQUIRE_MENTION=true
