# LLM provider (shared by both containers)
ANTHROPIC_API_KEY=sk-ant-...

# Slack workspace name (shared)
VOX_SLACK_WORKSPACE=my-workspace

# ── Bot container ────────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-*)
VOX_SLACK_BOT_TOKEN=xoxb-...
# App-Level Token for Socket Mode (xapp-*)
VOX_SLACK_APP_TOKEN=xapp-...
# Operator user IDs (comma-separated)
VOX_SLACK_OPERATORS=U0123456789
# Operator group IDs (comma-separated, optional)
# VOX_SLACK_OPERATOR_GROUPS=S0123456789
# Require @mention in channels (true/false)
VOX_SLACK_REQUIRE_MENTION=true

# ── Proxy container ─────────────────────────────────────────────────
# User OAuth Token (xoxp-*)
VOX_SLACK_USER_TOKEN=xoxp-...
# Posture: observe (read-only) or participate (read/write)
VOX_SLACK_POSTURE=observe
# Channels to watch (comma-separated, empty = all joined)
# VOX_SLACK_WATCH_CHANNELS=C0123,C4567
